{% extends 'base.html' %}

{% block title %}Emotional Ping • LifeLine{% endblock %}

{% block content %}
<style>
  /* ── Emotional Ping page-specific styles ── */
  .ep-page {
    width: 100%;
    padding: 22px 16px 40px;
  }

  .ep-shell {
    width: min(1240px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.25fr 1fr;
    gap: 16px;
    align-items: start;
  }

  .ep-card {
    background: rgba(15, 23, 42, 0.72);
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 20px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
    padding: 18px;
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .ep-card h1 { margin: 0 0 6px; font-size: 34px; }
  .ep-card h2 { margin: 0 0 6px; font-size: 20px; }
  .ep-sub { color: #9ca3af; font-size: 13px; line-height: 1.35; }

  .ep-chips { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 10px; }
  .ep-chip {
    padding: 9px 12px; border-radius: 999px;
    border: 1px solid rgba(148, 163, 184, 0.22);
    background: rgba(2, 6, 23, 0.35);
    cursor: pointer; -webkit-user-select: none; user-select: none; font-weight: 650; font-size: 13px;
    transition: transform 0.08s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .ep-chip:hover { transform: translateY(-1px); }
  .ep-chip.selected {
    border-color: rgba(34, 197, 94, 0.45);
    background: rgba(34, 197, 94, 0.14);
  }

  .ep-msg {
    width: 100%; margin-top: 14px; min-height: 84px; resize: none;
    border-radius: 16px; border: 1px solid rgba(148, 163, 184, 0.18);
    background: rgba(2, 6, 23, 0.35); padding: 12px; color: #e5e7eb; outline: none;
  }
  .ep-msg::placeholder { color: rgba(156, 163, 175, 0.7); }

  .ep-hint { margin-top: 10px; font-size: 13px; color: #9ca3af; }
  .ep-hint.error { color: #fecaca; }
  .ep-hint.success { color: #bbf7d0; }

  .ep-actions { display: flex; align-items: center; gap: 10px; margin-top: 12px; }
  .ep-spacer { flex: 1; }

  .ep-btn {
    border: 1px solid rgba(148, 163, 184, 0.18);
    background: rgba(15, 23, 42, 0.45); color: #e5e7eb;
    padding: 10px 14px; border-radius: 999px; cursor: pointer;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.28);
    transition: transform 0.08s ease, background 0.2s ease;
    font-weight: 650; text-decoration: none;
    display: inline-flex; align-items: center; gap: 8px;
  }
  .ep-btn:hover { transform: translateY(-1px); background: rgba(15, 23, 42, 0.65); }
  .ep-btn:disabled { opacity: 0.55; cursor: not-allowed; transform: none; }
  .ep-btn.primary {
    background: linear-gradient(180deg, rgba(34, 197, 94, 0.25), rgba(34, 197, 94, 0.12));
    border-color: rgba(34, 197, 94, 0.35);
  }
  .ep-btn.small { padding: 8px 11px; font-size: 12px; }

  #ep-feed { margin-top: 12px; display: grid; gap: 10px; }

  .ep-empty {
    padding: 14px; border-radius: 16px;
    border: 1px dashed rgba(148, 163, 184, 0.25);
    background: rgba(2, 6, 23, 0.25); color: #94a3b8;
  }

  .ep-post {
    border-radius: 18px; border: 1px solid rgba(148, 163, 184, 0.18);
    background: rgba(2, 6, 23, 0.3); padding: 12px;
  }
  .ep-post-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 8px; }
  .ep-who { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .ep-avatar {
    width: 38px; height: 38px; border-radius: 16px; display: grid; place-items: center;
    font-weight: 800;
    background: linear-gradient(180deg, rgba(6, 182, 212, 0.18), rgba(34, 197, 94, 0.18));
    border: 1px solid rgba(6, 182, 212, 0.22); flex: 0 0 auto;
  }
  .ep-name { font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 240px; }
  .ep-meta { font-size: 12px; color: #9ca3af; margin-top: 1px; }
  .ep-mood { font-size: 12px; color: #c7d2fe; opacity: 0.95; flex: 0 0 auto; }
  .ep-post-body { color: rgba(229, 231, 235, 0.92); line-height: 1.35; white-space: pre-wrap; }
  .ep-post-actions { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }

  .ep-psy-list { margin-top: 12px; display: grid; gap: 10px; }
  .ep-psy-item {
    border-radius: 18px; border: 1px solid rgba(148, 163, 184, 0.18);
    background: rgba(2, 6, 23, 0.3); padding: 12px;
  }
  .ep-psy-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
  .ep-psy-name { font-weight: 850; line-height: 1.2; }
  .ep-psy-hospital { margin-top: 4px; font-size: 12px; color: #94a3b8; }
  .ep-psy-meta { margin-top: 8px; display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
  .ep-stars { display: inline-flex; gap: 2px; align-items: center; font-size: 12px; color: rgba(34, 197, 94, 0.95); }
  .ep-rating-num { margin-left: 6px; font-size: 12px; color: #9ca3af; font-weight: 700; }
  .ep-fee { font-size: 12px; font-weight: 850; color: rgba(34, 197, 94, 0.95); }
  .ep-min-0 { min-width: 0; }
  .ep-title-sub { color: #6ee7b7; font-size: 10px; margin-top: 2px; }
  .ep-mt-12 { margin-top: 12px; }

  @media (max-width: 980px) {
    .ep-shell { grid-template-columns: 1fr; }
  }

  /* ── Light-mode overrides ── */
  html:not(.dark) .ep-card {
    background: rgba(255,255,255,0.75) !important;
    border-color: rgba(190,210,205,0.5) !important;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05) !important;
  }
  html:not(.dark) .ep-chip {
    background: rgba(255,255,255,0.6) !important;
    border-color: rgba(180,200,195,0.45) !important;
    color: #1e293b !important;
  }
  html:not(.dark) .ep-chip.selected {
    border-color: rgba(34,197,94,0.5) !important;
    background: rgba(34,197,94,0.12) !important;
  }
  html:not(.dark) .ep-msg {
    background: rgba(255,255,255,0.7) !important;
    border-color: rgba(180,200,195,0.45) !important;
    color: #1e293b !important;
  }
  html:not(.dark) .ep-msg::placeholder { color: #94a3b8 !important; }
  html:not(.dark) .ep-btn {
    background: rgba(255,255,255,0.7) !important;
    border-color: rgba(180,200,195,0.45) !important;
    color: #1e293b !important;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04) !important;
  }
  html:not(.dark) .ep-btn:hover {
    background: rgba(255,255,255,0.9) !important;
  }
  html:not(.dark) .ep-btn.primary {
    background: linear-gradient(180deg, rgba(16,185,129,0.15), rgba(16,185,129,0.06)) !important;
    border-color: rgba(16,185,129,0.35) !important;
    color: #047857 !important;
  }
  html:not(.dark) .ep-sub { color: #475569 !important; }
  html:not(.dark) .ep-hint { color: #64748b !important; }
  html:not(.dark) .ep-hint.error { color: #dc2626 !important; }
  html:not(.dark) .ep-hint.success { color: #059669 !important; }
  html:not(.dark) .ep-post {
    background: rgba(255,255,255,0.6) !important;
    border-color: rgba(190,210,205,0.45) !important;
  }
  html:not(.dark) .ep-post-body { color: #334155 !important; }
  html:not(.dark) .ep-mood { color: #6366f1 !important; }
  html:not(.dark) .ep-meta { color: #64748b !important; }
  html:not(.dark) .ep-name { color: #1e293b !important; }
  html:not(.dark) .ep-empty {
    background: rgba(255,255,255,0.4) !important;
    border-color: rgba(180,200,195,0.35) !important;
    color: #64748b !important;
  }
  html:not(.dark) .ep-psy-item {
    background: rgba(255,255,255,0.6) !important;
    border-color: rgba(190,210,205,0.45) !important;
  }
  html:not(.dark) .ep-psy-name { color: #1e293b !important; }
  html:not(.dark) .ep-psy-hospital { color: #64748b !important; }
  html:not(.dark) .ep-avatar {
    background: linear-gradient(180deg, rgba(6,182,212,0.12), rgba(34,197,94,0.12)) !important;
    border-color: rgba(6,182,212,0.2) !important;
    color: #1e293b !important;
  }
  html:not(.dark) .ep-rating-num { color: #64748b !important; }
</style>

<div class="ep-page">
  <div class="ep-shell">
    <!-- Left column: Ping form -->
    <div class="ep-card">
      <h1>Emotional Ping</h1>
      <p class="ep-sub">
        Share how you feel. Your ping will notify trusted helpers. You can
        also browse other pings in the feed.
      </p>

      <div class="ep-chips" id="chips">
        <div class="ep-chip" data-mood="FEELING_LOW">😔 Feeling Low</div>
        <div class="ep-chip" data-mood="FRUSTRATED">😤 Frustrated</div>
        <div class="ep-chip" data-mood="HAPPY">😊 Happy</div>
        <div class="ep-chip" data-mood="ANXIOUS">😰 Anxious</div>
        <div class="ep-chip" data-mood="NEED_MOTIVATION">🫶 Need Motivation</div>
        <div class="ep-chip" data-mood="FEELING_FESTIVE">🎉 Feeling Festive</div>
      </div>

      <textarea class="ep-msg" id="message" placeholder="Add a short message (optional)"></textarea>

      <div class="ep-hint" id="hint">Pick a feeling to enable sending.</div>

      <div class="ep-actions">
        <button class="ep-btn primary" id="sendBtn" disabled>Send Ping</button>
        <div class="ep-spacer"></div>
        <button class="ep-btn" id="refreshBtn" type="button">Refresh Feed</button>
      </div>
    </div>

    <!-- Center column: Feed -->
    <div class="ep-card feed">
      <h2>Others Emotional Pings</h2>
      <div class="ep-sub">
        Browse recent emotional pings. You can chat, mark listened, or uplift.
      </div>
      <div id="ep-feed"></div>
    </div>

    <!-- Right column: Psychiatrists -->
    <div class="ep-card">
      <h2>Renowned Psychiatrists</h2>
      <div class="ep-sub">
        Book an appointment with verified specialists. Pay first to confirm your slot.
      </div>

      <div class="ep-psy-list">
        {% if psychiatrists and psychiatrists|length > 0 %}
          {% for p in psychiatrists %}
          <div class="ep-psy-item">
            <div class="ep-psy-top">
              <div class="ep-min-0">
                <div class="ep-psy-name">{{ p.name }}</div>
                <div class="ep-psy-hospital">{{ p.hospital }}</div>
                <div class="ep-psy-hospital ep-title-sub">{{ p.title }}</div>
              </div>
              <a class="ep-btn small primary" href="{{ url_for('book_psychiatrist', psychiatrist_id=p.id) }}">Book</a>
            </div>
            <div class="ep-psy-meta">
              <div>
                <span class="ep-stars" aria-label="Rating">
                  ★★★★★
                  <span class="ep-rating-num">{{ "%.1f"|format(p.rating) }}</span>
                </span>
              </div>
              <div class="ep-fee">৳{{ p.fee_bdt }}+</div>
            </div>
          </div>
          {% endfor %}
        {% else %}
          <div class="ep-empty">No psychiatrists configured yet.</div>
        {% endif %}
      </div>

      <div class="ep-mt-12">
        <a class="ep-btn" href="{{ url_for('psychiatrists_list') }}">View all</a>
      </div>
    </div>
  </div>
</div>

<script>
  const API_PING_URL = "{{ url_for('api_emotional_ping') }}";
  const API_FEED_URL = "{{ url_for('api_emotional_pings') }}";
  const LOGIN_URL = "/login";
  const CURRENT_USER_ID = {{ current_user.id | tojson }};
  const IS_ADMIN = {{ (current_user.is_admin) | tojson }};

  let selectedMood = null;

  const chips = document.querySelectorAll(".ep-chip");
  const sendBtn = document.getElementById("sendBtn");
  const refreshBtn = document.getElementById("refreshBtn");
  const hint = document.getElementById("hint");
  const feed = document.getElementById("ep-feed");

  function setHint(text, type) {
    hint.textContent = text;
    hint.classList.remove("error", "success");
    if (type) hint.classList.add(type);
  }

  function updateSendState() {
    sendBtn.disabled = !selectedMood;
  }

  function prettyMood(m) {
    return (m || "").replaceAll("_", " ").toLowerCase();
  }

  function initials(name) {
    const s = (name || "?").trim();
    if (!s) return "?";
    const parts = s.split(/\s+/);
    const a = parts[0]?.[0] || "?";
    const b = parts.length > 1 ? parts[parts.length - 1]?.[0] : "";
    return (a + b).toUpperCase();
  }

  function escapeHTML(str) {
    return (str || "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  async function fetchJSON(url, options = {}) {
    const res = await fetch(url, { credentials: "same-origin", ...options });
    const contentType = res.headers.get("content-type") || "";
    const isJson = contentType.includes("application/json");

    if (res.status === 401) return { __unauthorized: true, status: 401 };

    if (!res.ok) {
      let json = null;
      let text = "";
      if (isJson) json = await res.json().catch(() => null);
      else text = await res.text().catch(() => "");
      return { __error: true, status: res.status, json, text };
    }

    if (!isJson) {
      const text = await res.text().catch(() => "");
      if ((text || "").toLowerCase().includes("<html")) {
        return { __unauthorized: true, status: 401 };
      }
      return { message: text || "OK" };
    }

    return await res.json().catch(() => ({}));
  }

  function renderPost(p) {
    const div = document.createElement("div");
    div.className = "ep-post";

    const safeName = escapeHTML(p.user_name || "Unknown");
    const safeMeta = escapeHTML(p.created_at_human || "");
    const safeMood = escapeHTML(prettyMood(p.mood));
    const safeMsg = p.message ? escapeHTML(p.message) : "";
    
    // Check if current user can delete this ping
    const canDelete = CURRENT_USER_ID != null && (Number(p.user_id) === Number(CURRENT_USER_ID) || IS_ADMIN === true);

    div.innerHTML = `
      <div class="ep-post-head">
        <div class="ep-who">
          <div class="ep-avatar">${initials(p.user_name)}</div>
          <div style="min-width:0">
            <div class="ep-name">${safeName}</div>
            <div class="ep-meta">${safeMeta}</div>
          </div>
        </div>
        <div class="ep-mood">${safeMood}</div>
      </div>
      <div class="ep-post-body">${
        safeMsg ? safeMsg : "<span style='opacity:.6'>No message provided.</span>"
      }</div>
      <div class="ep-post-actions">
        <button class="ep-btn small listened" data-action="listen" data-ping-id="${p.id}"
          ${p.is_listened ? "disabled" : ""}>
          ${p.is_listened ? "Listened ✔" : "Listen"}
        </button>
        <button class="ep-btn small" data-action="chat" data-user-id="${p.user_id ?? ""}">Chat</button>
        <button class="ep-btn small" data-action="uplift" data-ping-id="${p.id}">Uplift</button>
        ${canDelete ? `<button class="ep-btn small" data-action="delete" data-ping-id="${p.id}" style="color:#ef4444;border-color:rgba(239,68,68,0.3)">Delete</button>` : ''}
      </div>
    `;

    div.addEventListener("click", (e) => {
      const btn = e.target.closest("button");
      if (!btn) return;
      const action = btn.dataset.action;

      if (action === "chat") {
        const uid = btn.dataset.userId;
        if (!uid) return alert("Cannot start chat: user not found.");
        window.location.href = `/chat/${uid}`;
        return;
      }

      if (action === "listen") {
        const pingId = btn.dataset.pingId;
        fetch(`/api/emotional_pings/${pingId}/listen`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
        })
          .then((res) => res.json())
          .then((data) => {
            if (data.ok) { btn.textContent = "Listened ✔"; btn.disabled = true; }
            else alert("Failed to mark as listened");
          })
          .catch((err) => { console.error(err); alert("Error connecting to server"); });
        return;
      }

      if (action === "uplift") {
        const pingId = btn.dataset.pingId;
        fetch(`/api/emotional_pings/${pingId}/uplift`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
        })
          .then((res) => res.json())
          .then((data) => {
            if (data.ok) loadFeed();
            else alert("Failed to uplift");
          })
          .catch((err) => { console.error(err); alert("Error uplifting post"); });
        return;
      }

      if (action === "delete") {
        const pingId = btn.dataset.pingId;
        if (!confirm("Are you sure you want to delete this emotional ping?")) return;
        
        btn.disabled = true;
        btn.textContent = "Deleting...";
        
        fetch(`/api/emotional_pings/${pingId}`, {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
        })
          .then((res) => res.json())
          .then((data) => {
            if (data.ok) {
              loadFeed(); // Reload the feed to remove the deleted ping
            } else {
              alert(data.error || "Failed to delete ping");
              btn.disabled = false;
              btn.textContent = "Delete";
            }
          })
          .catch((err) => {
            console.error(err);
            alert("Error connecting to server");
            btn.disabled = false;
            btn.textContent = "Delete";
          });
        return;
      }
    });

    return div;
  }

  async function loadFeed() {
    feed.innerHTML = `<div class="ep-empty">Loading emotional pings…</div>`;

    const data = await fetchJSON(API_FEED_URL);

    if (data.__unauthorized) {
      feed.innerHTML = `<div class="ep-empty">You are not logged in. <a href="${LOGIN_URL}" style="color:#059669">Log in</a> to see the feed.</div>`;
      return;
    }

    if (data.__error) {
      feed.innerHTML = `<div class="ep-empty">Could not load feed (HTTP ${data.status}).<br/><span style="opacity:.85">${escapeHTML(
        data.json?.error || data.json?.message || data.text || ""
      )}</span></div>`;
      return;
    }

    const pings = data.pings || [];
    feed.innerHTML = "";

    if (!pings.length) {
      feed.innerHTML = `<div class="ep-empty">No emotional pings yet. Be the first to post one 💗</div>`;
      return;
    }

    pings.forEach((p) => feed.appendChild(renderPost(p)));
  }

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      chips.forEach((c) => c.classList.remove("selected"));
      chip.classList.add("selected");
      selectedMood = chip.dataset.mood;
      updateSendState();
      setHint("Ready — click Send Ping.");
    });
  });

  sendBtn.addEventListener("click", async () => {
    const message = document.getElementById("message").value.trim();
    if (!selectedMood) return setHint("Please pick a feeling first.", "error");

    sendBtn.disabled = true;
    const oldText = sendBtn.textContent;
    sendBtn.textContent = "Sending…";
    setHint("Sending ping…");

    const data = await fetchJSON(API_PING_URL, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ mood: selectedMood, message }),
    });

    if (data.__unauthorized) {
      setHint("Please log in to send an emotional ping.", "error");
      setTimeout(() => (window.location.href = LOGIN_URL), 600);
      sendBtn.textContent = oldText;
      updateSendState();
      return;
    }

    if (data.__error) {
      const msg = data.json?.error || data.json?.message || data.text || `Failed (HTTP ${data.status})`;
      setHint(msg, "error");
      sendBtn.textContent = oldText;
      updateSendState();
      return;
    }

    setHint(data.message || "Ping sent successfully 💗", "success");
    document.getElementById("message").value = "";
    chips.forEach((c) => c.classList.remove("selected"));
    selectedMood = null;
    updateSendState();
    await loadFeed();
    sendBtn.textContent = oldText;
    updateSendState();
  });

  refreshBtn.addEventListener("click", loadFeed);
  loadFeed();
</script>
{% endblock %}
